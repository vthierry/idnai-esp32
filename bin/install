#!/bin/bash -e

if [ "$1" = -h -o "$1" = --help ]
then cat <<EOU
Internal usage: install
- Installs the idnai-esp32 framework files.
EOU
exit
fi

backup() {
 if [ -f "$1" ] ; then backup "$1~" ; mv $f $f~ ; fi
}

NAME="`basename $PWD`"

if [ \! -f "$NAME.ino" ] ; then cat <<EOF $NAME.ino
// The IDE root file
//  Implements the application specific web service handle in setup_handles.cpp
EOF
fi				

cat <<EOF > hostname.h
// This allows to define the DHCP hostname, to identify the device
// CAUTION => this file is automatically generated

#define HOSTNAME "$NAME"
EOF

backup wifi.h ; cat <<EOF > wifi.h
// Wifi network connection credentials
// => Edit this wifi.h file adding the correct SSID and PASSWORD for all possible networks.
//    This wifi access points will be tested in sequence.
//    This file is NOT to be publish on the git bunddle for obvious security reasons.

std::vector <std::pair<String, String>> wifis = {
  // {"SSID", "PASSWORD"},
};
EOF

if [ \! -f "IP.txt" ] ; then cat '192.168.1.27' > IP.txt ; fi

if [ \! -f "verbose.h" ] ; then cat <<EOF verbose.h
// Sets the verbose mode (or not): if
//  - true, messages are printed on the serial link for debugging.

bool VERBOSE = true;
EOF
fi

if [ \! -f "setup_handles.cpp" ] ; then cat <<EOF > setup_handles.cpp
// Application specific web-service handles
// => Edit this file to implement the hardware mechanisms and the application specific handles

#include "node_modules/idnai-eps32/src/esp32.hpp"

// This is an application dependent service handle
void handle_$hostname()
{
}

void setup_handles()
{
  // Here comes the code to init the hardware and/or application specific variables.

  // This is how an web service handle is hooked to the web service.
  server_on("/$hostname", handle_$hostname);

  //
  // Predefined web servive handle
  // => Comment or delete the lines of code to invalidate them
  //
  
  // Confirms the web service is alive
  // - Returns the alive delay and the average and last loop delay
  server_on("/hi", handle_alive);

  // Restarts the processor
  server_on("/restart", handle_restart);

  // Put the processor in deep sleep
  server_on("/sleep", handle_sleep);

  // Handles the web pages
  server_on("/", handle_web_page);

  // Handles the GPIO generic I/O web page
  server_on("/gpio", handle_gpio);
}
EOF
fi
if [ \! -f "web_page_h.html" ] ; then cat <<EOF > web_page_h.html
<html>
  <head>
    <title>Your control panel</title>
    <link rel='stylesheet' href='https://vthierry.github.com/idnai-web/webcontrols.css'/>
    <script type='text/javascript' src='https://vthierry.github.com/idnai-web/webcontrols.js'></script>
    <script type='text/javascript' src='https://vthierry.github.com/idnai-web/fetchService.js'></script>
  </head>
  <body style='width:820px'>
    <h1>Your control panel</h1>
    <div class='button-bar'>
      <button title='Ping the web service to verify if alive' onclick='fetchService("@/hi", (r)->consoleLog(r));' style='background-color:yellow'>Ping</button>
      <button title='Restart the ESP32 microcontroler' onclick='fetchService("@/restart", (r)->consoleLog(r));' style='background-color:red'>Restart</button>
      <a class='button' href="./gpio/">GPIO pannel</a>
    </div>
    <script>webcontrols.addConsole();</script>
  </body>
</html>
EOF
				      
ln -s node_modules/indnai-esp32/src/esp32.cpp

ln -s node_modules/indnai-esp32/src/gpio_handles.cpp
 
git add $NAME.ino hostname.h setup_handles.cpp verbose.h esp32.cpp gpio_handles.cpp
